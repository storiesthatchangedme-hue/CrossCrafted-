{
  "buildCommand": "cd frontend && npm install && CI=false DISABLE_ESLINT_PLUGIN=true npm run build",
  "outputDirectory": "frontend/build",
  "functions": {
    "api/index.js": {
      "runtime": "@vercel/node",
      "includeFiles": "frontend/build/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    }
  ]
}
